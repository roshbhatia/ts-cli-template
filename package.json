{
  "name": "example",
  "version": "0.2.1",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "module": "src/main.ts",
  "bin": {
    "example": "src/main.ts"
  },
  "scripts": {
    "build": "bun build src/main.ts --outdir dist --target bun --format esm",
    "check": "bun run format:check && bun run typecheck && bun test",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "nix:lock": "bunx bun2nix -o bun.nix",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@roshbhatia/ts-utils": "https://github.com/roshbhatia/ts-utils/archive/refs/tags/v0.2.0.tar.gz",
    "effect": "4.0.0-beta.83"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.3.13",
    "@types/node": "24.12.2",
    "@typescript/native-preview": "7.0.0-dev.20251207.1",
    "bun2nix": "2.1.2",
    "typescript": "5.8.2"
  }
}
